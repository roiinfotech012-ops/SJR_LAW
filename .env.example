# Canonical Site URL (used for metadata, OpenGraph, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.sjrlawcollege.in

# Enquiry, Alumni Registration & Grievance Delivery Webhook (Optional)
# Configure a JSON webhook endpoint (e.g., SMTP relay, Resend/SendGrid proxy, or CRM endpoint)
# When unset, submissions are validated and persisted locally to data/submissions.jsonl in non-serverless environments
# and return HTTP 503 with clear configuration guidance if delivery is required.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# Optional Resend API configuration for email delivery
RESEND_API_KEY=
ENQUIRY_RECIPIENT_EMAIL=sjrcl.principal@gmail.com
ADMISSIONS_RECIPIENT_EMAIL=admnsjrcl@gmail.com
